{
  "name": "@ohm-js/lsp",
  "version": "17.6.0-alpha.0",
  "description": "Language Server Protocol adapter for @ohm-js/language",
  "keywords": [
    "parser",
    "parsing",
    "ohm",
    "ohm-js",
    "lsp",
    "language-server"
  ],
  "homepage": "https://github.com/ohmjs/ohm#readme",
  "bugs": {
    "url": "https://github.com/ohmjs/ohm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmjs/ohm.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "ava"
  },
  "dependencies": {
    "@ohm-js/language": "workspace:^",
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "ava": "^6.0.0",
    "ohm-js": "workspace:^"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "src/**/*.test.ts",
      "test/**/*.test.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
